        window.handleHospitalReset = function() {
            let excelInput = document.getElementById('hosp_excelFile');
            let distSelect = document.getElementById('hosp_districtSelect');
            let centreSelect = document.getElementById('hosp_centreSelect');
            let filterType = document.getElementById('hosp_filterType');
            let searchBtn = document.getElementById('hosp_searchBtn');
            let auditBtn = document.getElementById('hosp_auditBtn');
            let textSearch = document.getElementById('hosp_textSearch');
            let tbody = document.getElementById('hosp_tableBody');
            let countBadge = document.getElementById('hosp_recordCount');

            if(excelInput) excelInput.value = '';
            if(distSelect) { distSelect.innerHTML = '<option value="">-- प्रथम एक्सेल फाईल लोड करा --</option>'; distSelect.disabled = true; }
            if(centreSelect) { centreSelect.innerHTML = '<option value="">-- प्रथम जिल्हा निवडा --</option>'; centreSelect.disabled = true; }
            if(filterType) filterType.disabled = true;
            if(textSearch) { textSearch.value = ''; textSearch.disabled = true; }
            if(searchBtn) searchBtn.disabled = true;
            if(auditBtn) auditBtn.disabled = true;
            if(tbody) tbody.innerHTML = '<tr><td colspan="10" style="text-align:center; color:gray; padding:20px;">कृपया एक्सेल फाईल निवडून सर्च सुरू करा.</td></tr>';
            if(countBadge) countBadge.textContent = '0';

            window.hosp_rawData = [];
            window.currentAuditStats = null;
