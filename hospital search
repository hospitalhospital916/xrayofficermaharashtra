        // Attach global handlers for tab switching and basic user session
        window.openTab = function(tabId, btn) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
            
            let target = document.getElementById(tabId);
            if(target) target.classList.add('active');
            if(btn) btn.classList.add('active');
        };

        window.closeModal = function(id) {
            let el = document.getElementById(id);
            if(el) el.style.display = 'none';
        };

        window.loginMemberWithMobileAndPassword = function() {
            document.getElementById('loginOverlay').style.display = 'none';
            document.getElementById('appContent').style.display = 'flex';
        };

        window.logoutMember = function() {
            document.getElementById('appContent').style.display = 'none';
            document.getElementById('loginOverlay').style.display = 'flex';
        };

        // ==========================================
        // HOSPITAL MIS EXCEL & AUDIT REPORT LOGIC (EXPLICITLY ATTACHED TO WINDOW)
        // ==========================================
        window.handleExcelUpload = function(e) {
            let file = e.target ? e.target.files[0] : document.getElementById('hosp_excelFile').files[0];
            if(!file) return;

            Swal.fire({title: 'एक्सेल फाईल वाचत आहे...', allowOutsideClick: false, didOpen: () => Swal.showLoading()});

            let reader = new FileReader();
            reader.onload = function(evt) {
                try {
                    let data = new Uint8Array(evt.target.result);
                    let workbook = XLSX.read(data, {type: 'array'});
                    let firstSheet = workbook.SheetNames[0];
                    window.hosp_rawData = XLSX.utils.sheet_to_json(workbook.Sheets[firstSheet]);

                    window.populateHospDistricts();
                    Swal.close();
                    Swal.fire('यशस्वी!', `एक्सेल मधील ${window.hosp_rawData.length} रेकॉर्ड्स लोड झाले आहेत.`, 'success');
                } catch(err) {
                    Swal.close();
                    Swal.fire('त्रुटी', 'फाईल वाचताना अडचण आली: ' + err.message, 'error');
                }
            };
            reader.readAsArrayBuffer(file);
        };

        window.populateHospDistricts = function() {
            let districts = [...new Set(window.hosp_rawData.map(item => item.District))].filter(Boolean).sort();
            let districtSelect = document.getElementById('hosp_districtSelect');
            districtSelect.innerHTML = '<option value="">-- जिल्हा निवडा --</option>';
            
            districts.forEach(dist => {
                let opt = document.createElement('option');
                opt.value = dist;
                opt.textContent = dist;
                districtSelect.appendChild(opt);
            });

            districtSelect.disabled = false;
        };

        window.handleDistrictChange = function() {
            let selectedDistrict = document.getElementById('hosp_districtSelect').value;
            let centreSelect = document.getElementById('hosp_centreSelect');
            centreSelect.innerHTML = '<option value="">-- सर्व रुग्णालये --</option>';

            if(!selectedDistrict) {
                centreSelect.disabled = true;
                document.getElementById('hosp_filterType').disabled = true;
            } else {
                let filteredCentres = [...new Set(
                    window.hosp_rawData.filter(item => item.District === selectedDistrict).map(item => item.CentreName)
                )].filter(Boolean).sort();

                filteredCentres.forEach(centre => {
                    let opt = document.createElement('option');
                    opt.value = centre;
                    opt.textContent = centre;
                    centreSelect.appendChild(opt);
                });

                centreSelect.disabled = false;
                document.getElementById('hosp_filterType').disabled = false;
            }
            document.getElementById('hosp_searchBtn').disabled = false;
            window.handleHospitalSearch();
        };

        window.handleHospitalSearch = function() {
            let selectedDistrict = document.getElementById('hosp_districtSelect').value;
            let selectedCentre = document.getElementById('hosp_centreSelect').value;
            let filterType = document.getElementById('hosp_filterType').value;

            // Hospital specific dataset for audit calculation
            let hospData = window.hosp_rawData.filter(item => {
                let matchDist = !selectedDistrict || item.District === selectedDistrict;
                let matchCentre = !selectedCentre || item.CentreName === selectedCentre;
                return matchDist && matchCentre;
            });

            // Calculate Audit Indicators
            window.calculateAuditIndicators(hospData, selectedDistrict, selectedCentre);

            // Filter for display table
            let tableData = hospData.filter(item => {
                if (filterType === 'EMERGENCY') return item.Priority === 'Emergency';
                if (filterType === 'ROUTINE') return item.Priority !== 'Emergency';
                if (filterType === 'BEYOND_TAT') return item.IsBeyondTAT == 1 || item.IsBeyondTAT === '1';
                return true;
            });

            window.renderHospTable(tableData);
            document.getElementById('hosp_auditBtn').disabled = hospData.length === 0;
        };

        window.calculateAuditIndicators = function(data, dist, centre) {
            let totalScans = data.length;
            
            let emCases = data.filter(d => d.Priority === 'Emergency');
            let emTotal = emCases.length;
            let emOntime = emCases.filter(d => d.IsBeyondTAT == 0 || d.IsBeyondTAT === '0').length;
            let emDelayed = emCases.filter(d => d.IsBeyondTAT == 1 || d.IsBeyondTAT === '1').length;
            let emCompliance = emTotal > 0 ? ((emOntime / emTotal) * 100).toFixed(1) : "100.0";

            let rtCases = data.filter(d => d.Priority !== 'Emergency');
            let rtTotal = rtCases.length;
            let rtOntime = rtCases.filter(d => d.IsBeyondTAT == 0 || d.IsBeyondTAT === '0').length;
            let rtDelayed = rtCases.filter(d => d.IsBeyondTAT == 1 || d.IsBeyondTAT === '1').length;
            let rtCompliance = rtTotal > 0 ? ((rtOntime / rtTotal) * 100).toFixed(1) : "100.0";

            let overallOntime = data.filter(d => d.IsBeyondTAT == 0 || d.IsBeyondTAT === '0').length;
            let overallDelayed = data.filter(d => d.IsBeyondTAT == 1 || d.IsBeyondTAT === '1').length;
            let overallCompliance = totalScans > 0 ? ((overallOntime / totalScans) * 100).toFixed(1) : "100.0";

            let deductionSlab = "Nil (0% Penalty)";
            let compVal = parseFloat(overallCompliance);
            if (compVal >= 90.0 && compVal < 100.0) deductionSlab = "1% Deduction Applicable";
            else if (compVal < 90.0) deductionSlab = "Penalty / Higher Deduction Applicable";

            // Update UI Cards
            document.getElementById('st_aud_total').innerText = totalScans;
            
            document.getElementById('st_aud_em_total').innerText = emTotal;
            document.getElementById('st_aud_em_ontime').innerText = emOntime;
            document.getElementById('st_aud_em_delayed').innerText = emDelayed;
            document.getElementById('st_aud_em_compliance').innerText = emCompliance + "%";

            document.getElementById('st_aud_rt_total').innerText = rtTotal;
            document.getElementById('st_aud_rt_ontime').innerText = rtOntime;
            document.getElementById('st_aud_rt_delayed').innerText = rtDelayed;
            document.getElementById('st_aud_rt_compliance').innerText = rtCompliance + "%";

            document.getElementById('st_aud_overall_compliance').innerText = overallCompliance + "%";
            document.getElementById('st_aud_overall_ontime').innerText = overallOntime;
            document.getElementById('st_aud_overall_delayed').innerText = overallDelayed;
            document.getElementById('st_aud_deduction_slab').innerText = deductionSlab;

            // Save for PDF Generator
            window.currentAuditStats = {
                district: dist || 'महाराष्ट्र',
                hospital: centre || 'सर्व रुग्णालये',
                totalScans, emTotal, emOntime, emDelayed, emCompliance,
                rtTotal, rtOntime, rtDelayed, rtCompliance,
                overallOntime, overallDelayed, overallCompliance, deductionSlab
            };
        };

        window.renderHospTable = function(data) {
            let tbody = document.getElementById('hosp_tableBody');
            tbody.innerHTML = '';
            document.getElementById('hosp_recordCount').textContent = data.length;

            if(data.length === 0) {
                tbody.innerHTML = '<tr><td colspan="10" style="text-align:center; color:red;">माहिती उपलब्ध नाही.</td></tr>';
                return;
            }

            let displayData = data.slice(0, 500);

            displayData.forEach((row, index) => {
                let isDelayed = row.IsBeyondTAT == 1 || row.IsBeyondTAT === '1';
                let tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>${index + 1}</td>
                    <td><b>${row.District || '-'}</b></td>
                    <td>${row.CentreName || '-'}</td>
                    <td><b>${row.PatientName || '-'}</b></td>
                    <td><small>${row.PatientID || '-'}</small></td>
                    <td>${row.StudyName || '-'}</td>
                    <td><span class="badge ${row.Priority === 'Emergency' ? 'bg-danger' : 'bg-info'}">${row.Priority || 'Routine'}</span></td>
                    <td><small>${row.ScanDate || '-'}</small></td>
                    <td><small>${row.Report_TAT || '-'}</small></td>
                    <td><span class="badge ${isDelayed ? 'bg-danger' : 'bg-success'}">${isDelayed ? '⚠ Beyond TAT (>1 hr)' : '✓ On Time'}</span></td>
                `;
                tbody.appendChild(tr);
            });
        };

