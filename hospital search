    <!-- ADVANCED ROBUST JAVASCRIPT ENGINE -->
    <script>
        window.hosp_rawData = [];
        window.hosp_filteredData = [];
        window.hosp_currentPage = 1;
        window.hosp_pageSize = 100;
        window.currentAuditStats = null;

        window.openTab = function(tabId, btn) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
            let target = document.getElementById(tabId);
            if(target) target.classList.add('active');
            if(btn) btn.classList.add('active');
        };

        window.closeModal = function(id) {
            let el = document.getElementById(id); if(el) el.style.display = 'none';
        };

        window.loginMemberWithMobileAndPassword = function() {
            let overlay = document.getElementById('loginOverlay');
            let content = document.getElementById('appContent');
            if(overlay) overlay.style.display = 'none';
            if(content) content.style.display = 'flex';
        };

        window.logoutMember = function() {
            let overlay = document.getElementById('loginOverlay');
            let content = document.getElementById('appContent');
            if(content) content.style.display = 'none';
            if(overlay) overlay.style.display = 'flex';
        };

        // ==========================================
        // SMART COLUMN LOOKUP HELPER
        // ==========================================
        function getVal(row, candidates) {
            if (!row) return '';
            let keys = Object.keys(row);
            for (let candidate of candidates) {
                let candClean = candidate.toLowerCase().replace(/[^a-z0-9]/g, '');
                for (let k of keys) {
                    let kClean = k.toLowerCase().replace(/[^a-z0-9]/g, '');
                    if (kClean === candClean && row[k] !== undefined && row[k] !== null) {
                        return row[k];
                    }
                }
            }
            return '';
        }

        // Emergency Detection (Checks 'Priority' column values for Emergency)
        function isEmergencyCase(row) {
            let prio = String(getVal(row, ['Priority', 'PriorityCategory', 'Emergency', 'CaseType', 'Type'])).trim().toLowerCase();
            return prio === 'emergency' || prio.includes('emerg') || prio === 'e' || prio === 'yes' || prio === '1';
        }

        // Beyond TAT Detection (Checks 'IsBeyondTAT' column)
        function isBeyondTatCase(row) {
            let rawTat = getVal(row, ['IsBeyondTAT', 'Is Beyond TAT', 'BeyondTAT', 'Beyond TAT', 'Delayed', 'IsDelayed']);
            if (rawTat === 1 || rawTat === '1' || String(rawTat).trim() === '1' || String(rawTat).trim().toLowerCase() === 'true' || String(rawTat).trim().toLowerCase() === 'yes') {
                return true;
            }
            if (rawTat === 0 || rawTat === '0' || String(rawTat).trim() === '0' || String(rawTat).trim().toLowerCase() === 'false' || String(rawTat).trim().toLowerCase() === 'no') {
                return false;
            }

            // Fallback checking Report_TAT string if 1 or 0 is missing
            let tatStr = String(getVal(row, ['Report_TAT', 'Report TAT', 'TAT'])).trim();
            if (tatStr) {
                let daysMatch = tatStr.match(/(\d+)\s*Days?/i);
                let hrsMatch = tatStr.match(/(\d+)\s*hrs?/i);
                let minsMatch = tatStr.match(/(\d+)\s*Min/i);
                
                let d = daysMatch ? parseInt(daysMatch[1]) : 0;
                let h = hrsMatch ? parseInt(hrsMatch[1]) : 0;
                let m = minsMatch ? parseInt(minsMatch[1]) : 0;
                let totalMins = (d * 1440) + (h * 60) + m;
                
                if (isEmergencyCase(row)) {
                    return totalMins > 60; // Emergency 1 Hour
                } else {
                    return totalMins > 720; // Routine 12 Hours
                }
            }
            return false;
        }

        // ==========================================
        // FAST EXCEL PARSER (WEB WORKER OR DIRECT)
        // ==========================================
        window.handleExcelUploadFast = function(event) {
            let file = event.target.files[0];
            if(!file) return;

            let statusEl = document.getElementById('hosp_loader_status');
            if(statusEl) statusEl.style.display = 'inline-block';

            Swal.fire({
                title: 'एक्सेल फाईल वाचत आहे...',
                text: 'कृपया वाट पहा, डेटा लोड होत आहे...',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            let reader = new FileReader();
            reader.onload = function(e) {
                setTimeout(() => {
                    try {
                        let data = new Uint8Array(e.target.result);
                        let workbook = XLSX.read(data, {type: 'array', cellDates: true});
                        let firstSheet = workbook.SheetNames[0];
                        window.hosp_rawData = XLSX.utils.sheet_to_json(workbook.Sheets[firstSheet]) || [];

                        window.populateHospDistricts();
                        if(statusEl) statusEl.style.display = 'none';

                        Swal.close();
                        Swal.fire('यशस्वी!', `एक्सेल मधील ${window.hosp_rawData.length} रेकॉर्ड्स यशस्वीरीत्या लोड झाले आहेत.`, 'success');
                    } catch(err) {
                        if(statusEl) statusEl.style.display = 'none';
                        Swal.close();
                        Swal.fire('त्रुटी', 'एक्सेल फाईल वाचताना अडचण आली: ' + err.message, 'error');
                    }
                }, 100);
            };
            reader.readAsArrayBuffer(file);
        };

        window.populateHospDistricts = function() {
            let districts = [...new Set(window.hosp_rawData.map(item => String(getVal(item, ['District', 'DistrictName'])).trim()))].filter(Boolean).sort();
            let districtSelect = document.getElementById('hosp_districtSelect');
            if(!districtSelect) return;

            districtSelect.innerHTML = '<option value="">-- सर्व जिल्हे --</option>';
            districts.forEach(dist => {
                let opt = document.createElement('option');
                opt.value = dist;
                opt.textContent = dist;
                districtSelect.appendChild(opt);
            });

            districtSelect.disabled = false;
            document.getElementById('hosp_textSearch').disabled = false;
            document.getElementById('hosp_searchBtn').disabled = false;
            window.handleDistrictChange();
        };

        window.handleDistrictChange = function() {
            let distSelect = document.getElementById('hosp_districtSelect');
            let centreSelect = document.getElementById('hosp_centreSelect');
            let filterType = document.getElementById('hosp_filterType');

            if(!distSelect || !centreSelect) return;
            let selectedDistrict = distSelect.value;
            centreSelect.innerHTML = '<option value="">-- सर्व रुग्णालये --</option>';

            let filteredCentres = [...new Set(
                window.hosp_rawData
                    .filter(item => !selectedDistrict || String(getVal(item, ['District', 'DistrictName'])).trim() === selectedDistrict.trim())
                    .map(item => String(getVal(item, ['CentreName', 'Centre Name', 'Facility'])).trim())
            )].filter(Boolean).sort();

            filteredCentres.forEach(centre => {
                let opt = document.createElement('option');
                opt.value = centre;
                opt.textContent = centre;
                centreSelect.appendChild(opt);
            });

            centreSelect.disabled = false;
            if(filterType) filterType.disabled = false;

            window.handleHospitalSearch();
        };

        window.handleHospitalSearch = function() {
            let distEl = document.getElementById('hosp_districtSelect');
            let centreEl = document.getElementById('hosp_centreSelect');
            let filterEl = document.getElementById('hosp_filterType');
            let textEl = document.getElementById('hosp_textSearch');
            let auditBtn = document.getElementById('hosp_auditBtn');

            let selectedDistrict = distEl ? distEl.value.trim() : '';
            let selectedCentre = centreEl ? centreEl.value.trim() : '';
            let filterType = filterEl ? filterEl.value : 'ALL';
            let txtQuery = textEl ? textEl.value.trim().toLowerCase() : '';

            let hospData = window.hosp_rawData.filter(item => {
                let itemDist = String(getVal(item, ['District', 'DistrictName'])).trim();
                let itemCentre = String(getVal(item, ['CentreName', 'Centre Name', 'Facility'])).trim();
                
                let matchDist = !selectedDistrict || itemDist === selectedDistrict;
                let matchCentre = !selectedCentre || itemCentre === selectedCentre;
                return matchDist && matchCentre;
            });

            // Calculate indicators based on ALL records for that hospital
            window.calculateAuditIndicators(hospData, selectedDistrict, selectedCentre);

            // Filter for display in the table below
            window.hosp_filteredData = hospData.filter(item => {
                let isEm = isEmergencyCase(item);
                let isDel = isBeyondTatCase(item);

                let matchText = true;
                if (txtQuery) {
                    let pName = String(getVal(item, ['PatientName', 'Name'])).toLowerCase();
                    let pId = String(getVal(item, ['PatientID', 'PRN_No', 'ID'])).toLowerCase();
                    let study = String(getVal(item, ['StudyName', 'Modality'])).toLowerCase();
                    matchText = pName.includes(txtQuery) || pId.includes(txtQuery) || study.includes(txtQuery);
                }

                if (!matchText) return false;

                if (filterType === 'ALL_EMERGENCY') return isEm;
                if (filterType === 'EMERGENCY_ONTIME') return isEm && !isDel;
                if (filterType === 'EMERGENCY_DELAYED') return isEm && isDel;
                if (filterType === 'ROUTINE_ONTIME') return !isEm && !isDel;
                if (filterType === 'ROUTINE_DELAYED') return !isEm && isDel;
                if (filterType === 'ALL_BEYOND_TAT') return isDel;
                return true;
            });

            window.hosp_currentPage = 1;
            window.renderHospTablePaged();
            if(auditBtn) auditBtn.disabled = (hospData.length === 0);
        };

        window.calculateAuditIndicators = function(data, dist, centre) {
            let total = data.length;
            
            let emCases = data.filter(d => isEmergencyCase(d));
            let emTotal = emCases.length;
            let emDelayed = emCases.filter(d => isBeyondTatCase(d)).length;
            let emOntime = emTotal - emDelayed;
            let emCompliance = emTotal > 0 ? ((emOntime / emTotal) * 100).toFixed(1) : "100.0";

            let rtCases = data.filter(d => !isEmergencyCase(d));
            let rtTotal = rtCases.length;
            let rtDelayed = rtCases.filter(d => isBeyondTatCase(d)).length;
            let rtOntime = rtTotal - rtDelayed;
            let rtCompliance = rtTotal > 0 ? ((rtOntime / rtTotal) * 100).toFixed(1) : "100.0";

            let overallDelayed = data.filter(d => isBeyondTatCase(d)).length;
            let overallOntime = total - overallDelayed;
            let overallCompliance = total > 0 ? ((overallOntime / total) * 100).toFixed(1) : "100.0";

            let deductionSlab = "Nil (0% Penalty)";
            let compVal = parseFloat(overallCompliance);
            if (compVal >= 90.0 && compVal < 100.0) deductionSlab = "1% Deduction Applicable";
            else if (compVal < 90.0) deductionSlab = "Penalty / Higher Deduction Applicable";

            let setTxt = (id, val) => { let el = document.getElementById(id); if(el) el.innerText = val; };
            setTxt('st_aud_total', total);
            setTxt('st_aud_em_total', emTotal);
            setTxt('st_aud_em_ontime', emOntime);
            setTxt('st_aud_em_delayed', emDelayed);
            
            setTxt('st_aud_rt_total', rtTotal);
            setTxt('st_aud_rt_ontime', rtOntime);
            setTxt('st_aud_rt_delayed', rtDelayed);

            setTxt('st_aud_overall_compliance', overallCompliance + "%");
            setTxt('st_aud_deduction_slab', deductionSlab);

            window.currentAuditStats = {
                district: dist || 'महाराष्ट्र',
                hospital: centre || 'ग्रामीण रुग्णालय',
                total, emTotal, emOntime, emDelayed, emCompliance,
                rtTotal, rtOntime, rtDelayed, rtCompliance,
                overallOntime, overallDelayed, overallCompliance, deductionSlab
            };
        };

        window.renderHospTablePaged = function() {
            let tbody = document.getElementById('hosp_tableBody');
            let countBadge = document.getElementById('hosp_recordCount');
            let pageIndicator = document.getElementById('hosp_page_indicator');
            if(!tbody) return;

            tbody.innerHTML = '';
            let totalRecs = window.hosp_filteredData.length;
            if(countBadge) countBadge.textContent = totalRecs;

            if(totalRecs === 0) {
                tbody.innerHTML = '<tr><td colspan="10" style="text-align:center; color:red; padding:15px;">काहीही माहिती आढळली नाही.</td></tr>';
                if(pageIndicator) pageIndicator.textContent = 'पेज 0 / 0';
                return;
            }

            let totalPages = Math.ceil(totalRecs / window.hosp_pageSize);
            if(pageIndicator) pageIndicator.textContent = `पेज ${window.hosp_currentPage} / ${totalPages}`;

            let startIdx = (window.hosp_currentPage - 1) * window.hosp_pageSize;
            let pageSlice = window.hosp_filteredData.slice(startIdx, startIdx + window.hosp_pageSize);

            let fragment = document.createDocumentFragment();

            pageSlice.forEach((row, i) => {
                let isEm = isEmergencyCase(row);
                let isDel = isBeyondTatCase(row);

                let tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>${startIdx + i + 1}</td>
                    <td><b>${getVal(row, ['District', 'DistrictName']) || '-'}</b></td>
                    <td>${getVal(row, ['CentreName', 'Facility']) || '-'}</td>
                    <td><b>${getVal(row, ['PatientName', 'Name']) || '-'}</b></td>
                    <td><small>${getVal(row, ['PatientID', 'PRN_No', 'ID']) || '-'}</small></td>
                    <td>${getVal(row, ['StudyName', 'Modality']) || '-'}</td>
                    <td><span style="background:${isEm ? '#dc2626' : '#0284c7'}; color:white; padding:2px 6px; border-radius:4px; font-size:0.75rem;">${isEm ? '🚨 Emergency' : 'Routine'}</span></td>
