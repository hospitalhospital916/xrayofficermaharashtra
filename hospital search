<!-- OPTIMIZED HIGH-PERFORMANCE JAVASCRIPT ENGINE (WEB WORKER & PAGINATION) -->
<!-- ================================================================= -->
<script>
window.hosp_rawData = [];
window.hosp_filteredData = [];
window.hosp_currentPage = 1;
window.hosp_pageSize = 100; // एकावेळी फक्त १०० ओळी दाखवणार (ब्राऊजर हँग होणार नाही)
window.currentAuditStats = null;

// १. Web Worker वापरून मोठी एक्सेल फाईल बॅकग्राउंडमध्ये रीड करणे
window.handleExcelUploadFast = function(event) {
    let file = event.target.files[0];
    if(!file) return;

    let statusEl = document.getElementById('hosp_loader_status');
    if(statusEl) statusEl.style.display = 'inline-block';

    Swal.fire({
        title: 'एक्सेल फाईल प्रोसेसिंग सुरू आहे...',
        text: 'मोठी फाईल असल्यास काही सेकंद लागू शकतात, वेबपेज हँग होणार नाही.',
        allowOutsideClick: false,
        didOpen: () => { Swal.showLoading(); }
    });

    let reader = new FileReader();
    reader.onload = function(e) {
        let arrayBuffer = e.target.result;
        
        // Inline Web Worker Code तयार करणे
        let workerCode = `
            self.importScripts('https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js');
            self.onmessage = function(e) {
                let data = new Uint8Array(e.data);
                let workbook = XLSX.read(data, {type: 'array', cellDates: true});
                let firstSheet = workbook.SheetNames[0];
                let json = XLSX.utils.sheet_to_json(workbook.Sheets[firstSheet]);
                self.postMessage(json);
            };
        `;

        let blob = new Blob([workerCode], {type: 'application/javascript'});
        let worker = new Worker(URL.createObjectURL(blob));

        worker.postMessage(arrayBuffer, [arrayBuffer]);

        worker.onmessage = function(e) {
            window.hosp_rawData = e.data || [];
            worker.terminate();

            window.populateHospDistricts();
            if(statusEl) statusEl.style.display = 'none';

            Swal.close();
            Swal.fire('यशस्वी!', `एकूण ${window.hosp_rawData.length} रेकॉर्ड्स अत्यंत वेगाने लोड झाले आहेत.`, 'success');
        };

        worker.onerror = function(err) {
            if(statusEl) statusEl.style.display = 'none';
            Swal.close();
                Swal.fire('त्रुटी', 'फाईल वाचताना अडचण आली: ' + err.message, 'error');
            worker.terminate();
        };
    };
    reader.readAsArrayBuffer(file);
};

// २. जिल्ह्यांची यादी पॉप्युलेट करणे
window.populateHospDistricts = function() {
    let districts = [...new Set(window.hosp_rawData.map(i => i.District))].filter(Boolean).sort();
    let distSelect = document.getElementById('hosp_districtSelect');
    if(!distSelect) return;

    distSelect.innerHTML = '<option value="">-- सर्व जिल्हे --</option>';
    districts.forEach(d => {
        let opt = document.createElement('option');
        opt.value = d;
        opt.textContent = d;
        distSelect.appendChild(opt);
    });

    distSelect.disabled = false;
    document.getElementById('hosp_searchBtn').disabled = false;
    window.handleDistrictChange();
};

// ३. जिल्हा बदलल्यावर रुग्णालयांची यादी अपडेट करणे
window.handleDistrictChange = function() {
    let distVal = document.getElementById('hosp_districtSelect').value;
    let centreSelect = document.getElementById('hosp_centreSelect');
    let filterType = document.getElementById('hosp_filterType');

    centreSelect.innerHTML = '<option value="">-- सर्व रुग्णालये --</option>';

    let subset = distVal ? window.hosp_rawData.filter(i => i.District === distVal) : window.hosp_rawData;
    let centres = [...new Set(subset.map(i => i.CentreName))].filter(Boolean).sort();

    centres.forEach(c => {
        let opt = document.createElement('option');
        opt.value = c;
        opt.textContent = c;
        centreSelect.appendChild(opt);
    });

    centreSelect.disabled = false;
    filterType.disabled = false;

    window.handleHospitalSearch();
};

// ४. सर्च आणि फिल्टर लॉजिक (१ तास आणि १२ तास TAT नुसार वर्गीकरण)
window.handleHospitalSearch = function() {
    let selectedDist = document.getElementById('hosp_districtSelect').value;
    let selectedCentre = document.getElementById('hosp_centreSelect').value;
    let filterType = document.getElementById('hosp_filterType').value;

    let baseData = window.hosp_rawData.filter(item => {
        let matchDist = !selectedDist || item.District === selectedDist;
        let matchCentre = !selectedCentre || item.CentreName === selectedCentre;
        return matchDist && matchCentre;
    });

    // अचूक ऑडिट आकडेमोड (Summary Cards)
    window.calculateAuditIndicators(baseData, selectedDist, selectedCentre);

    // TAT फिल्टर लागू करणे
    window.hosp_filteredData = baseData.filter(item => {
        let isEmergency = (item.Priority === 'Emergency');
        let isBeyond = (item.IsBeyondTAT == 1 || item.IsBeyondTAT === '1');

        if (filterType === 'EMERGENCY_ONTIME') return isEmergency && !isBeyond;
        if (filterType === 'EMERGENCY_DELAYED') return isEmergency && isBeyond;
        if (filterType === 'ROUTINE_ONTIME') return !isEmergency && !isBeyond;
        if (filterType === 'ROUTINE_DELAYED') return !isEmergency && isBeyond;
        if (filterType === 'ALL_BEYOND_TAT') return isBeyond;
        return true;
    });

    window.hosp_currentPage = 1;
    window.renderHospTablePaged();

    document.getElementById('hosp_auditBtn').disabled = (baseData.length === 0);
};

// ५. १ तास व १२ तास TAT साठी अचूक इंडिकेटर्स मोजणे
window.calculateAuditIndicators = function(data, dist, centre) {
    let total = data.length;

    let emCases = data.filter(d => d.Priority === 'Emergency');
    let emTotal = emCases.length;
    let emOntime = emCases.filter(d => d.IsBeyondTAT == 0 || d.IsBeyondTAT === '0').length;
    let emDelayed = emCases.filter(d => d.IsBeyondTAT == 1 || d.IsBeyondTAT === '1').length;
    let emCompliance = emTotal > 0 ? ((emOntime / emTotal) * 100).toFixed(1) : "100.0";

    let rtCases = data.filter(d => d.Priority !== 'Emergency');
    let rtTotal = rtCases.length;
    let rtOntime = rtCases.filter(d => d.IsBeyondTAT == 0 || d.IsBeyondTAT === '0').length;
    let rtDelayed = rtCases.filter(d => d.IsBeyondTAT == 1 || d.IsBeyondTAT === '1').length;
    let rtCompliance = rtTotal > 0 ? ((rtOntime / rtTotal) * 100).toFixed(1) : "100.0";

    let overallOntime = data.filter(d => d.IsBeyondTAT == 0 || d.IsBeyondTAT === '0').length;
    let overallDelayed = data.filter(d => d.IsBeyondTAT == 1 || d.IsBeyondTAT === '1').length;
    let overallCompliance = total > 0 ? ((overallOntime / total) * 100).toFixed(1) : "100.0";

    let deductionSlab = "Nil (0% Penalty)";
    let compVal = parseFloat(overallCompliance);
    if (compVal >= 90.0 && compVal < 100.0) deductionSlab = "1% Deduction Applicable";
    else if (compVal < 90.0) deductionSlab = "Penalty / Higher Deduction Applicable";

    let setTxt = (id, val) => { let el = document.getElementById(id); if(el) el.innerText = val; };
    setTxt('st_aud_total', total);
    setTxt('st_aud_em_total', emTotal);
    setTxt('st_aud_em_ontime', emOntime);
    setTxt('st_aud_em_delayed', emDelayed);
    setTxt('st_aud_em_compliance', emCompliance + "%");

    setTxt('st_aud_rt_total', rtTotal);
    setTxt('st_aud_rt_ontime', rtOntime);
    setTxt('st_aud_rt_delayed', rtDelayed);
    setTxt('st_aud_rt_compliance', rtCompliance + "%");

    setTxt('st_aud_overall_compliance', overallCompliance + "%");
    setTxt('st_aud_overall_ontime', overallOntime);
    setTxt('st_aud_overall_delayed', overallDelayed);
    setTxt('st_aud_deduction_slab', deductionSlab);

    window.currentAuditStats = {
        district: dist || 'महाराष्ट्र',
        hospital: centre || 'सर्व रुग्णालये',
        total, emTotal, emOntime, emDelayed, emCompliance,
        rtTotal, rtOntime, rtDelayed, rtCompliance,
        overallOntime, overallDelayed, overallCompliance, deductionSlab
    };
};

// ६. पेजिनेशन टेबल रेंडरर (१०० च्या तुकड्यांमध्ये दाखवणे)
window.renderHospTablePaged = function() {
    let tbody = document.getElementById('hosp_tableBody');
    let countBadge = document.getElementById('hosp_recordCount');
    let pageIndicator = document.getElementById('hosp_page_indicator');

    if(!tbody) return;
    tbody.innerHTML = '';

    let totalRecs = window.hosp_filteredData.length;
    if(countBadge) countBadge.textContent = totalRecs;

    if(totalRecs === 0) {
        tbody.innerHTML = '<tr><td colspan="10" style="text-align:center; color:red; padding:15px;">काहीही डेटा आढळला नाही.</td></tr>';
        if(pageIndicator) pageIndicator.textContent = 'पेज 0 / 0';
        return;
    }

    let totalPages = Math.ceil(totalRecs / window.hosp_pageSize);
    if(window.hosp_currentPage > totalPages) window.hosp_currentPage = totalPages;
    if(window.hosp_currentPage < 1) window.hosp_currentPage = 1;

    if(pageIndicator) pageIndicator.textContent = `पेज ${window.hosp_currentPage} / ${totalPages}`;

    let startIdx = (window.hosp_currentPage - 1) * window.hosp_pageSize;
    let endIdx = Math.min(startIdx + window.hosp_pageSize, totalRecs);
    let pageSlice = window.hosp_filteredData.slice(startIdx, endIdx);

    let fragment = document.createDocumentFragment();

    pageSlice.forEach((row, i) => {
        let isDelayed = (row.IsBeyondTAT == 1 || row.IsBeyondTAT === '1');
        let isEmergency = (row.Priority === 'Emergency');

        let tr = document.createElement('tr');
        tr.innerHTML = `
            <td>${startIdx + i + 1}</td>
            <td><b>${row.District || '-'}</b></td>
            <td>${row.CentreName || '-'}</td>
            <td><b>${row.PatientName || '-'}</b></td>
            <td><small>${row.PatientID || '-'}</small></td>
            <td>${row.StudyName || '-'}</td>
            <td><span class="badge ${isEmergency ? 'bg-danger' : 'bg-info'}">${row.Priority || 'Routine'}</span></td>
            <td><small>${row.ScanDate || '-'}</small></td>
            <td><small>${row.Report_TAT || '-'}</small></td>
            <td><span class="badge ${isDelayed ? 'bg-danger' : 'bg-success'}">${isDelayed ? '⚠ Beyond TAT' : '✓ On Time'}</span></td>
        `;
        fragment.appendChild(tr);
    });

    tbody.appendChild(fragment);
};

// ७. पेजिनेशन बटणे
window.changeHospPage = function(direction) {
    window.hosp_currentPage += direction;
    window.renderHospTablePaged();
};

// ८. A4 प्रिस्क्रिप्शन ऑडिट रिपोर्ट (PDF) प्रिंटर
window.printAuditReportPDF = function() {
    if(!window.currentAuditStats) return alert("कृपया प्रथम शोध घ्या.");
    let s = window.currentAuditStats;
    let mName = window.currentMember ? (window.currentMember.name || 'महेश हांगे') : 'महेश हांगे';

    let printArea = document.getElementById('printLetterArea');
    if(!printArea) return;

    printArea.innerHTML = `
        <div style="width:210mm; padding:18mm 20mm; box-sizing:border-box; background:white; font-family:'Mukta',sans-serif; line-height:1.5;">
            <div style="text-align:center; border-bottom:3px double #0B3D91; padding-bottom:10px; margin-bottom:15px;">
                <h2 style="color:#0B3D91; margin:0; font-size:1.3rem;">PRESCRIPTION AUDIT REPORT (X-RAY SERVICES)</h2>
                <h3 style="margin:4px 0; font-size:1.1rem; color:#1e293b;">${s.hospital.toUpperCase()}</h3>
                <p style="margin:0; font-weight:bold; font-size:0.9rem;">DISTRICT: ${s.district.toUpperCase()} | AUDIT PERIOD: 2025-2026</p>
            </div>

            <h4 style="color:#0B3D91; background:#e0f2fe; padding:6px 10px; border-left:4px solid #0B3D91; margin-top:15px;">१. प्रिस्क्रिप्शन व तपासणी आकडेवारी (Overview)</h4>
            <ul style="margin-left:20px; font-size:0.9rem; font-weight:600;">
                <li>एकूण एक्स-रे व CT Scans केलेले रुग्ण: <b>${s.total}</b></li>
                <li>प्रिस्क्रिप्शन / रेफरल स्लिप पडताळणी: <b>१००% पूर्ण व स्वाक्षरीकृत (100% Verified)</b></li>
