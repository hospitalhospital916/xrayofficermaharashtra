    `;

    printArea.style.display = 'block';
    let opt = { margin: 0, filename: `Audit_Report_${s.hospital}.pdf`, image: { type: 'jpeg', quality: 0.98 }, html2canvas: { scale: 2 }, jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' } };
