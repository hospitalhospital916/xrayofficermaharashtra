<!DOCTYPE html>
<html lang="mr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" id="viewportMeta" content="width=1280, initial-scale=0.3, minimum-scale=0.25, maximum-scale=3.0, user-scalable=yes">
    <title>सदस्य पोर्टल | क्ष-किरण वैज्ञानिक अधिकारी (गट-क) कर्मचारी संघटना महाराष्ट्र राज्य</title>
    
    <!-- External Libraries (CDN) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

    <script>
        function applyDesktopViewport() {
            if (window.innerWidth < 1280 && !document.body.classList.contains('chat-active-mode')) {
                var scale = window.innerWidth / 1280;
                document.querySelector('meta[name="viewport"]').setAttribute('content', 'width=1280, initial-scale=' + scale + ', maximum-scale=3.0, user-scalable=yes');
            }
        }
        applyDesktopViewport();
    </script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Mukta:wght@300;400;600;700;800&display=swap');

        :root {
            --primary: #0B3D91;
            --secondary: #f39c12;
            --gold: #FFC436;
            --success: #10b981;
            --danger: #ef4444;
            --info: #3b82f6;
            --dark: #1e293b;
            --purple: #8b5cf6;
            --bg-light: #f0f4f8;
            --white: #ffffff;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Mukta', sans-serif; }
        
        html, body { 
            min-height: 100vh; background-color: var(--bg-light); color: var(--dark); overflow-x: hidden; display: flex; flex-direction: column;
        }

        #loginOverlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(135deg, var(--dark), var(--primary)); display: flex; justify-content: center; align-items: center; z-index: 10000; padding: 15px; }
        .login-card { background: white; padding: 35px 25px; border-radius: 16px; box-shadow: 0 15px 35px rgba(0,0,0,0.4); width: 100%; max-width: 420px; text-align: center; }
        .login-card img.login-logo { width: 85px; height: 85px; border-radius: 50%; object-fit: contain; margin: 0 auto 12px; border: 3px solid var(--secondary); padding: 4px; background: #fff; }
        .login-card h2 { color: var(--primary); font-weight: 800; margin-bottom: 5px; font-size: 1.4rem; }
        .login-input-box { position: relative; margin: 15px 0; text-align: left; }
        .login-input-box label { font-size: 0.85rem; font-weight: bold; color: var(--dark); display: block; margin-bottom: 5px; }
        .login-input-wrapper { position: relative; }
        .login-input-wrapper span { position: absolute; left: 15px; top: 12px; font-weight: bold; color: var(--primary); font-size: 1.1rem; }
        .login-input-wrapper input { width: 100%; padding: 12px 15px 12px 55px; border: 2px solid #cbd5e1; border-radius: 8px; font-size: 1.1rem; font-weight: bold; outline: none; }
        .login-input-wrapper input.no-prefix { padding-left: 45px; }
        .login-input-wrapper i.icon-left { position: absolute; left: 15px; top: 14px; font-weight: bold; color: var(--primary); font-size: 1.1rem; }
        .login-input-wrapper input:focus { border-color: var(--primary); }
        .login-card button { width: 100%; padding: 12px; background: linear-gradient(90deg, var(--secondary), #f1c40f); color: var(--dark); border: none; border-radius: 8px; font-size: 1.1rem; font-weight: 800; cursor: pointer; transition: 0.3s; margin-top: 10px; }
        .login-card button:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(243,156,18,0.4); }

        .custom-modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.65); display: none; justify-content: center; align-items: center; z-index: 10005; padding: 15px; }
        .custom-modal { background: white; width: 100%; max-width: 900px; max-height: 92vh; border-radius: 14px; overflow-y: auto; box-shadow: 0 15px 35px rgba(0,0,0,0.3); }
        .custom-modal-header { background: var(--primary); color: white; padding: 15px 20px; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 10; }
        .custom-modal-body { padding: 20px; }
        .modal-section-title { font-size: 1rem; font-weight: 800; color: var(--primary); background: #E0F2FE; padding: 6px 12px; border-radius: 6px; margin: 15px 0 10px 0; display: flex; align-items: center; gap: 8px; border-left: 4px solid var(--info); }

        .navbar { background: var(--white); padding: 10px 18px; display: flex; justify-content: space-between; align-items: center; border-bottom: 4px solid var(--secondary); box-shadow: 0 4px 10px rgba(0,0,0,0.05); position: sticky; top: 0; z-index: 1000; flex-wrap: wrap; gap: 8px; }
        .navbar-brand { display: flex; align-items: center; gap: 10px; }
        .navbar-brand img { width: 48px; height: 48px; border-radius: 50%; object-fit: contain; border: 2px solid var(--primary); padding: 2px; }
        .navbar h2 { color: var(--primary); font-weight: 800; font-size: 1rem; line-height: 1.2; margin: 0; }
        .navbar small { font-size: 0.75rem; color: #64748b; font-weight: 600; display: block; }
        .nav-profile { display: flex; align-items: center; gap: 12px; }
        .btn-logout { background: var(--danger); color: white; border: none; padding: 6px 12px; border-radius: 6px; font-weight: bold; cursor: pointer; transition: 0.2s; font-size: 0.8rem; }

        .ticker-wrap { background: var(--primary); border-bottom: 2px solid var(--secondary); color: #fff; padding: 6px 15px; font-weight: 600; font-size: 0.88rem; }

        .tab-menu { display: flex; gap: 6px; overflow-x: auto; background: #07275e; padding: 8px 12px; white-space: nowrap; position: sticky; top: 0; z-index: 999; }
        .tab-menu::-webkit-scrollbar { height: 4px; }
        .tab-menu::-webkit-scrollbar-thumb { background: var(--secondary); border-radius: 10px; }
        .tab-btn { padding: 7px 14px; border: none; background: rgba(255,255,255,0.12); color: white; font-size: 0.85rem; font-weight: 700; cursor: pointer; border-radius: 8px; transition: 0.3s; display: inline-flex; align-items: center; gap: 6px; }
        .tab-btn:hover { background: rgba(255,255,255,0.25); }
        .tab-btn.active { background: var(--secondary); color: var(--dark); }

        #appContent { min-height: 100vh; display: flex; flex-direction: column; width: 100%; }
        .container { max-width: 1450px; width: 100%; margin: 15px auto; padding: 0 12px; flex: 1; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        .panel { background: var(--white); border-radius: 12px; box-shadow: 0 5px 20px rgba(0,0,0,0.05); margin-bottom: 20px; border: 1px solid #e2e8f0; overflow: hidden; }
        .panel-header { padding: 12px 16px; font-size: 1rem; font-weight: 800; background: #f8fafc; border-bottom: 1px solid #e2e8f0; border-top: 5px solid var(--primary); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; }
        .panel-body { padding: 15px; overflow-x: auto; }

        .member-profile-hero { background: linear-gradient(135deg, #ffffff 0%, #f0f4f8 100%); border: 2px solid var(--primary); border-radius: 16px; padding: 20px; margin-bottom: 20px; box-shadow: 0 10px 25px rgba(11, 61, 145, 0.12); }
        .profile-hero-grid { display: grid; grid-template-columns: 180px 1fr; gap: 25px; align-items: center; }
        @media (max-width: 768px) { .profile-hero-grid { grid-template-columns: 1fr; text-align: center; } }

        .profile-photo-container img { width: 150px; height: 150px; border-radius: 50%; object-fit: cover; border: 4px solid var(--primary); box-shadow: 0 8px 16px rgba(0,0,0,0.15); background: #fff; }
        .profile-badge-status { margin-top: 8px; display: inline-block; padding: 4px 12px; border-radius: 20px; font-size: 0.8rem; font-weight: 800; }
        .profile-info-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px 20px; background: #ffffff; padding: 16px; border-radius: 12px; border: 1px solid #cbd5e1; }
        .info-item { font-size: 0.9rem; border-bottom: 1px dashed #e2e8f0; padding-bottom: 4px; }
        .info-item b { color: var(--primary); display: block; font-size: 0.78rem; text-transform: uppercase; }
        .info-item span { color: var(--dark); font-weight: 700; }

        .btn-edit-profile-gold { background: linear-gradient(135deg, #FFC436, #f39c12) !important; color: #071938 !important; font-weight: 800 !important; border: 2px solid #d97706 !important; font-size: 0.95rem !important; padding: 8px 18px !important; border-radius: 8px !important; box-shadow: 0 4px 12px rgba(243, 156, 18, 0.35) !important; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; }

        .dash-cards-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; margin-bottom: 15px; }
        .dash-card-mini { background: #fff; border: 1px solid #e2e8f0; border-left: 5px solid var(--primary); padding: 12px 15px; border-radius: 10px; box-shadow: 0 2px 6px rgba(0,0,0,0.05); text-align: center; }
        .dash-card-mini h3 { font-size: 0.82rem; color: #64748b; margin-bottom: 4px; font-weight: 700; }
        .dash-card-mini h2 { font-size: 1.3rem; color: var(--dark); font-weight: 800; }

        .forms-cards-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 15px; }
        .auto-form-card { background: #fff; border: 1px solid #e2e8f0; border-top: 4px solid var(--primary); border-radius: 12px; padding: 16px; transition: all 0.3s ease; display: flex; flex-direction: column; justify-content: space-between; text-decoration: none; color: inherit; }
        .auto-form-card:hover { transform: translateY(-4px); box-shadow: 0 10px 20px rgba(11, 61, 145, 0.12); border-top-color: var(--secondary); }
        .auto-form-icon { width: 45px; height: 48px; border-radius: 10px; background: #eff6ff; color: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 1.4rem; margin-bottom: 10px; }

        .map-pie-grid { display: grid; grid-template-columns: 2.3fr 1fr; gap: 15px; margin-bottom: 15px; }
        @media (max-width: 900px) { .map-pie-grid { grid-template-columns: 1fr; } }
        .mandal-map-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 10px; padding: 10px; }
        .mandal-card { border-radius: 8px; color: white; padding: 10px; box-shadow: 0 2px 5px rgba(0,0,0,0.15); transition: transform 0.2s; text-align: center; }
        .dist-badge { display: inline-flex; justify-content: space-between; align-items: center; width: 100%; background: rgba(0,0,0,0.25); font-size: 0.68rem; padding: 3px 6px; margin: 2px 0; border-radius: 4px; font-weight: 600; }
        .dist-badge .dist-count { background: #fff; color: #000; padding: 1px 5px; border-radius: 10px; font-weight: 800; font-size: 0.62rem; }

        .btn-action { background: var(--primary); color: white; border: none; padding: 8px 14px; border-radius: 6px; font-weight: bold; cursor: pointer; transition: 0.2s; display: inline-flex; align-items: center; gap: 6px; font-size: 0.85rem; }
        .btn-action:hover { opacity: 0.9; transform: translateY(-1px); }
        .form-control { width: 100%; padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.9rem; outline: none; }
        .form-row { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 12px; align-items: center; }
        .form-row > div { flex: 1; min-width: 180px; }

        table { width: 100%; border-collapse: collapse; min-width: 700px; background: white; }
        th, td { padding: 10px 12px; text-align: left; border-bottom: 1px solid #e2e8f0; vertical-align: middle; font-size: 0.88rem; }
        th { background: var(--primary); color: white; font-weight: 800; white-space: nowrap; }
        tr:hover { background-color: #f8fafc; }
        .badge { padding: 4px 10px; border-radius: 12px; font-size: 0.75rem; font-weight: bold; color: #fff; display: inline-block; }
        .bg-success { background: var(--success); } .bg-warning { background: var(--secondary); color: #000; } .bg-danger { background: var(--danger); } .bg-primary { background: var(--primary); } .bg-info { background: var(--info); } .bg-purple { background: var(--purple); }

        #floatingLiveChatWidget { position: fixed; bottom: 35px; right: 35px; z-index: 9990; display: flex; align-items: center; gap: 12px; cursor: pointer; transition: transform 0.3s ease; }
        .chat-pill-label { background: linear-gradient(135deg, #1e293b, #0B3D91); color: #ffffff; padding: 10px 20px; border-radius: 30px; font-size: 1.05rem; font-weight: 800; box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3); border: 2px solid #f39c12; display: flex; align-items: center; gap: 8px; }
        .chat-floating-btn { width: 65px; height: 65px; background: linear-gradient(135deg, #f39c12, #d97706); color: white; border-radius: 50%; display: flex; justify-content: center; align-items: center; font-size: 2rem; box-shadow: 0 10px 25px rgba(243, 156, 18, 0.5); position: relative; border: 3.5px solid #ffffff; }

        @media print { .no-print { display: none !important; } .container { margin: 0 !important; padding: 0 !important; } }
    </style>
</head>
<body>

    <!-- 1. POPUP NOTICE MODAL -->
    <div id="memberLoginPopupModal" class="custom-modal-overlay">
        <div class="custom-modal" style="max-width:550px; text-align:center;">
            <div class="custom-modal-header bg-primary">
                <h3><i class="fa fa-bullhorn"></i> संघटनेची महत्त्वाची सूचना</h3>
                <button onclick="closeModal('memberLoginPopupModal')" style="background:transparent; border:none; color:white; font-size:1.5rem; cursor:pointer;">&times;</button>
            </div>
            <div class="custom-modal-body">
                <div id="popup_notice_content_area" style="font-size:1.05rem; color:#1e293b; line-height:1.6; margin:15px 0; font-weight:600;">
                    संघटनेच्या सर्व सदस्यांसाठी महत्त्वाची सूचना.
                </div>
                <button class="btn-action bg-success" onclick="closeModal('memberLoginPopupModal')" style="width:100%; justify-content:center; padding:10px; font-size:1rem; margin-top:10px;">
                    <i class="fa fa-check-circle"></i> समजले (OK)
                </button>
            </div>
        </div>
    </div>

    <!-- 2. MEMBER LOGIN OVERLAY -->
    <div id="loginOverlay">
        <div class="login-card">
            <img src="logo.png" alt="Association Logo" class="login-logo" onerror="this.src='loghho.png'">
            <h2>सदस्य लॉगिन PORTAL</h2>
            <p style="font-size: 0.85rem; color: #64748b; margin-bottom: 15px;">मोबाईल नंबर आणि पासवर्ड द्वारे लॉगिन करा</p>
            <div class="login-input-box">
                <label>मोबाईल नंबर:</label>
                <div class="login-input-wrapper">
                    <span>+91</span>
                    <input type="tel" id="loginMobileNumber" placeholder="९८६५४३२१०" maxlength="10">
                </div>
            </div>
            <div class="login-input-box">
                <label>पासवर्ड (Password):</label>
                <div class="login-input-wrapper">
                    <i class="fa fa-lock icon-left"></i>
                    <input type="password" id="loginPassword" class="no-prefix" placeholder="पासवर्ड टाका">
                </div>
            </div>
            <button type="button" onclick="loginMemberWithMobileAndPassword()"><i class="fa fa-sign-in-alt me-1"></i> सुरक्षित लॉगिन करा</button>
        </div>
    </div>

    <!-- MAIN APP CONTENT -->
    <div id="appContent" style="display: none;">
        
        <nav class="navbar">
            <div class="navbar-brand">
                <img src="logo.png" alt="Logo" onerror="this.src='loghho.png'">
                <div>
                    <h2>क्ष-किरण वैज्ञानिक अधिकारी संघटना</h2>
                    <small>महाराष्ट्र राज्य - अधिकृत सदस्य पोर्टल</small>
                </div>
            </div>
            <div class="nav-profile no-print">
                <div style="text-align: right;">
                    <span id="mem_nav_name" style="font-weight:800; color:var(--primary); font-size:0.95rem; display:block;">-</span>
                    <span id="mem_nav_status" style="font-size:0.78rem; font-weight:bold;">-</span>
                </div>
                <button class="btn-logout" onclick="logoutMember()"><i class="fa fa-power-off"></i> लॉगआउट</button>
            </div>
        </nav>

        <div class="ticker-wrap no-print">
            <marquee id="memberTickerText" behavior="scroll" direction="left" scrollamount="6">
                क्ष-किरण वैज्ञानिक अधिकारी (गट-क) कर्मचारी संघटना महाराष्ट्र राज्य पोर्टलवर आपले स्वागत आहे.
            </marquee>
        </div>

        <div class="tab-menu no-print">
            <button class="tab-btn active" onclick="openTab('tab-dash', this)"><i class="fa fa-user-circle"></i> डॅशबोर्ड</button>
            <button class="tab-btn" onclick="openTab('tab-hospital-search', this)"><i class="fa fa-hospital"></i> हॉस्पिटल MIS डेटा व ऑडिट</button>
            <button class="tab-btn" onclick="openTab('tab-auto-forms', this)"><i class="fa fa-file-signature"></i> स्वयंचलित अर्ज प्रणाली</button>
            <button class="tab-btn" onclick="openTab('tab-icard', this)"><i class="fa fa-id-card"></i> डिजिटल आय-कार्ड</button>
            <button class="tab-btn" onclick="openTab('tab-receipt', this)"><i class="fa fa-receipt"></i> माझी ई-पावती</button>
            <button class="tab-btn" onclick="openTab('tab-templates', this)"><i class="fa fa-pen-nib"></i> पत्र जनरेटर</button>
            <button class="tab-btn" onclick="openTab('tab-grievances', this)"><i class="fa fa-file-invoice"></i> तक्रार निवारण</button>
            <button class="tab-btn" onclick="openTab('tab-info-gather', this)"><i class="fa fa-clipboard-list"></i> माहिती द्या (फॉर्म)</button>
            <button class="tab-btn" onclick="openTab('tab-employees', this)"><i class="fa fa-users"></i> राज्यातील कर्मचारी</button>
        </div>

        <div class="container">

            <!-- TAB 1: DASHBOARD OVERVIEW -->
            <div id="tab-dash" class="tab-content active">
                <div class="member-profile-hero">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px; border-bottom:2px solid var(--primary); padding-bottom:8px;">
                        <h3 style="color:var(--primary); font-weight:800; font-size:1.2rem;"><i class="fa fa-id-card-clip"></i> माझी नोंदणीकृत माहिती</h3>
                    </div>

                    <div class="profile-hero-grid">
                        <div class="profile-photo-container">
                            <img id="pf_hero_photo" src="https://cdn-icons-png.flaticon.com/512/3135/3135715.png" alt="Member Photo">
                            <div id="pf_hero_status_badge" class="profile-badge-status bg-success">Approved</div>
                        </div>

                        <div class="profile-info-grid">
                            <div class="info-item"><b>पूर्ण नाव</b><span id="pf_hero_name">-</span></div>
                            <div class="info-item"><b>पद / हुद्दा</b><span id="pf_hero_post">-</span></div>
                            <div class="info-item"><b>मोबाईल नंबर</b><span id="pf_hero_mobile">-</span></div>
                            <div class="info-item"><b>ई-मेल आयडी</b><span id="pf_hero_email">-</span></div>
                            <div class="info-item"><b>प्रवर्ग</b><span id="pf_hero_category">-</span></div>
                            <div class="info-item"><b>जिल्हा व मंडळ</b><span id="pf_hero_dist_mandal">-</span></div>
                        </div>
                    </div>
                </div>

                <div class="dash-cards-grid">
                    <div class="dash-card-mini" style="border-left-color: var(--primary);"><h3>सदस्यत्व स्थिती</h3><h2 id="st_approval_status" style="color:var(--primary);">-</h2></div>
                    <div class="dash-card-mini" style="border-left-color: var(--success);"><h3>शुल्क भरणा स्थिती</h3><h2 id="st_fee_status" style="color:var(--success);">-</h2></div>
                    <div class="dash-card-mini" style="border-left-color: var(--secondary);"><h3>माझा जिल्हा व मंडळ</h3><h2 id="st_district_mandal" style="color:var(--secondary); font-size:1.1rem;">-</h2></div>
                    <div class="dash-card-mini" style="border-left-color: var(--purple);"><h3>माझ्या तक्रारी</h3><h2 id="st_grievance_cnt" style="color:var(--purple);">0</h2></div>
                </div>
            </div>

            <!-- TAB 2: HOSPITAL MIS DATA & NEW TAB EDITABLE AUDIT REPORT GENERATOR -->
            <div id="tab-hospital-search" class="tab-content">
                <div class="panel">
                    <div class="panel-header bg-primary" style="color:white; padding: 10px 15px;">
                        <span><i class="fa fa-hospital"></i> जिल्हा व रुग्णालयनिहाय MIS डेटा शोध व प्रिस्क्रिप्शन ऑडिट रिपोर्ट (PPP Mode)</span>
                    </div>
                    <div class="panel-body" style="padding:15px;">
                        
                        <!-- १. कंट्रोल व फिल्टर बॉक्स -->
                        <div style="background:#f8fafc; border:1px solid #cbd5e1; padding:18px; border-radius:10px; margin-bottom:20px;">
                            <div class="form-row" style="display:flex; gap:12px; flex-wrap:wrap;">
