rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isLoggedIn() {
      return request.auth != null;
    }
    function isSuperAdmin() {
      return isLoggedIn() && (request.auth.token.adminType == 'master' || request.auth.token.adminEmail == 'hangemahesh498@gmail.com' || request.auth.token.email == 'hangemahesh498@gmail.com');
    }

    match /chat_messages/{document=**} { allow read, write: if true; }
    match /members/{memberId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn();
      allow update: if isLoggedIn() && (isSuperAdmin() || request.auth.uid == resource.data.uid || request.auth.token.role == 'admin');
      allow delete: if isLoggedIn() && (isSuperAdmin() || request.auth.token.role == 'admin');
    }
    match /profile_edit_requests/{document=**} {
      allow create, read: if true;
      allow update, delete: if isLoggedIn();
    }
    match /info_gathered/{document=**} {
      allow create, read: if true;
      allow update, delete: if isLoggedIn();
    }
    match /grievances/{document=**} {
      allow create, read: if true;
      allow update, delete: if isLoggedIn();
    }
    match /polls/{document=**} {
      allow read, update: if true;
      allow create, delete: if isLoggedIn();
    }
    match /notices/{document=**} {
      allow read: if true;
      allow create, update, delete: if isLoggedIn();
    }
    match /committee/{document=**} {
      allow read: if true;
      allow create, update, delete: if isLoggedIn();
    }
    match /gallery/{document=**} {
      allow read: if true;
      allow create, update, delete: if isLoggedIn();
    }
    match /settings/{document=**} {
      allow read: if true;
      allow create, update, delete: if isLoggedIn();
    }
    match /other_staff/{document=**} {
      allow read: if true;
      allow create, update, delete: if isLoggedIn();
    }
    match /member_logs/{document=**} { allow read, write: if true; }
    match /admin_logs/{document=**} { allow read, write: if isLoggedIn(); }
    match /member_documents/{document=**} { allow read, write: if isLoggedIn(); }
    match /member_requests/{document=**} { allow read, write: if isLoggedIn(); }
    match /support_tickets/{document=**} { allow read, write: if isLoggedIn(); }
    match /password_reset_requests/{document=**} { allow read, write: if false; }
    match /admins/{document=**} {
      allow read: if isLoggedIn();
      allow write: if isSuperAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
